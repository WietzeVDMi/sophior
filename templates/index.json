      "type": "sophior-review-slider",
      "blocks": {
        "review-1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "review_text": "De snijplank van SOPHIOR is prachtig. Zwaar, stabiel en ziet er fantastisch uit in mijn keuken. Al 6 maanden elke dag in gebruik en hij ziet er nog als nieuw uit.",
