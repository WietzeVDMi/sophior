        "usp-2": {
          "type": "accordion_item",
          "settings": {
            "question": "Van welke materialen zijn jullie producten gemaakt?",
            "answer": "We werken uitsluitend met premium materialen: RVS 18/10, acaciahout FSC-gecertificeerd en gehard glas. Elk materiaal is geselecteerd op levensduur en hygiëne."
          }
        },
        "usp-3": {
          "type": "accordion_item",
          "settings": {
            "question": "Hoe lang gaan SOPHIOR producten mee?",
            "answer": "Met de juiste verzorging gaan onze snijplanken en messen jaren mee. We bieden bij elk product onderhoudsinstructies en bijpassende beschermingsproducten."
          }
        },
        "usp-4": {
          "type": "accordion_item",
          "settings": {
            "question": "Zijn jullie producten vaatwasmachinebestendig?",
            "answer": "We raden handwassen aan voor onze houten producten. RVS producten zijn vaatwasmachinebestendig. Details per product zijn te vinden op de productpagina."
          }
        },
        "usp-5": {
          "type": "accordion_item",
          "settings": {
            "question": "Bieden jullie gratis verzending?",
            "answer": "Ja! Bij bestellingen vanaf €59 verzenden we gratis. Bestellingen geplaatst voor 15:00 worden dezelfde dag verzonden (werkdagen)."
          }
        }
      },
      "block_order": ["usp-1", "usp-2", "usp-3", "usp-4", "usp-5"],
      "settings": {
        "title": "Waarom SOPHIOR?"
