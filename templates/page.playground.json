    "pg-usp-1": {
      "type": "sophior-usp-accordion",
      "blocks": {
        "a1": { "type": "item", "settings": { "question": "Waarom SOPHIOR?", "answer": "SOPHIOR selecteert alleen producten die voldoen aan onze kwaliteitseisen. Elk product is getest door ons team en onze klanten." } },
        "a2": { "type": "item", "settings": { "question": "Wat is jullie retourbeleid?", "answer": "Je kunt producten binnen 30 dagen retourneren, mits ze ongebruikt zijn en in de originele verpakking zitten." } },
        "a3": { "type": "item", "settings": { "question": "Hoe lang duurt de levering?", "answer": "Bestellingen voor 22:00 worden de volgende werkdag bezorgd. We werken samen met DHL en PostNL." } },
        "a4": { "type": "item", "settings": { "question": "Zijn de producten garantie?", "answer": "Ja, alle SOPHIOR producten hebben minimaal 2 jaar garantie op materiaalfouten." } },
        "a5": { "type": "item", "settings": { "question": "Hoe onderhoud ik een snijplank?", "answer": "Smeer je snijplank maandelijks in met olie (bijv. snijplankolie of mineraalolie). Nooit in de vaatwasser — altijd handmatig wassen." } }
      },
      "block_order": ["a1", "a2", "a3", "a4", "a5"],
      "settings": {
        "title": "USP Accordeon — 5 items met afbeelding"
      }
    },
