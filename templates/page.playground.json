    "pg-usp-3": {
      "type": "sophior-usp-accordion",
      "blocks": {
        "a1": { "type": "item", "settings": { "question": "Edge: lang antwoord", "answer": "Dit is een heel lang antwoord om te testen of de accordion correct uitbreidt en de tekst goed leesbaar blijft. SOPHIOR kiest producten op basis van duurzaamheid, ambacht en dagelijks gebruiksgemak. Elk product heeft zijn eigen verhaal en elk materiaal heeft specifieke onderhoudsinstructies die we graag met je delen via onze gidsen." } }
