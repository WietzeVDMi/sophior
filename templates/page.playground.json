    "pg-reviews-1": {
      "type": "sophior-review-slider",
      "blocks": {
        "r1": { "type": "review", "settings": { "author": "Marieke V.", "location": "Amsterdam", "rating": 5, "text": "Prachtige snijplank, al 3 jaar in gebruik en ziet er nog nieuw uit. Echt top kwaliteit!", "date": "december 2025" } },
        "r2": { "type": "review", "settings": { "author": "Thomas K.", "location": "Rotterdam", "rating": 5, "text": "De pan verdeelt de warmte perfect. Mijn eieren bakken zonder aanbranden — eindelijk!", "date": "november 2025" } },
        "r3": { "type": "review", "settings": { "author": "Sophie B.", "location": "Utrecht", "rating": 5, "text": "Snelle levering, mooi verpakt en de kwaliteit overtreft de verwachtingen. Absoluut een aanrader.", "date": "oktober 2025" } },
        "r4": { "type": "review", "settings": { "author": "Pieter J.", "location": "Den Haag", "rating": 4, "text": "Goede prijs-kwaliteitverhouding. Het mes is scherp en goed in de hand.", "date": "september 2025" } },
        "r5": { "type": "review", "settings": { "author": "Lisa M.", "location": "Eindhoven", "rating": 5, "text": "Klantenservice was super behulpzaam toen ik vragen had over het onderhoud.", "date": "augustus 2025" } }
      },
      "block_order": ["r1", "r2", "r3", "r4", "r5"],
