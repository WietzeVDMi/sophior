{
  "sections": {
    "product-info": {
      "type": "sophior-product-info",
      "settings": {
        "enable_sticky_info": true,
        "picker_type": "button",
        "show_dynamic_checkout": true,
        "show_gift_card_recipient": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "certainties-bar": {
      "type": "sophior-certainties-bar",
      "blocks": {
        "certainty-1": {
          "type": "item",
          "settings": {
            "icon_type": "lock",
            "text": "Veilig betalen"
          }
        },
        "certainty-2": {
          "type": "item",
          "settings": {
            "icon_type": "truck",
            "text": "Gratis verzending v.a. €59"
          }
        },
        "certainty-3": {
          "type": "item",
          "settings": {
            "icon_type": "return",
            "text": "30 dagen retour"
          }
        },
        "certainty-4": {
          "type": "item",
          "settings": {
            "icon_type": "star",
            "text": "Premium kwaliteit"
          }
        }
      },
      "block_order": [
        "certainty-1",
        "certainty-2",
        "certainty-3",
        "certainty-4"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "product-description": {
      "type": "sophior-product-description",
      "settings": {
        "heading": "Over dit product",
        "show_heading": true,
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "reviews": {
      "type": "sophior-judge-placeholder",
      "settings": {
        "heading": "Klantbeoordelingen",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "product-faq": {
      "type": "sophior-product-faq",
      "blocks": {
        "faq-1": {
          "type": "question",
          "settings": {
            "question": "Wat is het materiaal van dit product?",
            "answer": "<p>Vul hier het antwoord in over het gebruikte materiaal.</p>"
          }
        },
        "faq-2": {
          "type": "question",
          "settings": {
            "question": "Hoe onderhoud ik dit product?",
            "answer": "<p>Vul hier de onderhoudsrichtlijnen in voor een lang productleven.</p>"
          }
        },
        "faq-3": {
          "type": "question",
          "settings": {
            "question": "Wat zijn de verzendkosten?",
            "answer": "<p>Gratis verzending bij bestellingen vanaf €59. Standaard levering in 1–3 werkdagen.</p>"
          }
        }
      },
      "block_order": [
        "faq-1",
        "faq-2",
        "faq-3"
      ],
      "settings": {
        "heading": "Veelgestelde vragen",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "product-info",
    "certainties-bar",
    "product-description",
    "reviews",
    "product-faq"
  ]
}
