{{ 'sophior-expertise-grid.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  sophior-expertise-grid — Productexpertise grid op de Over Ons pagina.
  4 afbeeldingen naast elkaar met tekstoverlay en CTA-knop per categorie.
  Briefing §8.5: "4 afbeeldingen naast elkaar, overlay per afbeelding met
  knop 'Meer info' of 'Bekijk gids' → linkt naar collectie/blog"
  CSS: assets/sophior-expertise-grid.css
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="sophior-expertise section-{{ section.id }}-padding"
    id="sophior-expertise-{{ section.id }}"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="sophior-expertise__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="sophior-expertise__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="sophior-expertise__item" {{ block.shopify_attributes }}>
            <div class="sophior-expertise__card">

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    class: 'sophior-expertise__image',
                    loading: 'lazy',
                    alt: block.settings.label | escape,
                    widths: '300, 400, 600',
                    sizes: '(max-width: 749px) 50vw, 25vw'
                }}
              {%- else -%}
                <div class="sophior-expertise__placeholder" aria-hidden="true"></div>
              {%- endif -%}

              <div class="sophior-expertise__overlay">
                {%- if block.settings.label != blank -%}
                  <span class="sophior-expertise__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}

                {%- if block.settings.link != blank and block.settings.link_text != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="sophior-expertise__cta"
                    aria-label="{{ block.settings.link_text | escape }} — {{ block.settings.label | escape }}"
                  >
                    {{- block.settings.link_text | escape -}}
                  </a>
                {%- elsif block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="sophior-expertise__cta"
                    aria-label="{{ 'sections.sophior-expertise-grid.view_label' | t: label: block.settings.label }}"
                  >
                    {{- 'sections.sophior-expertise-grid.default_cta' | t -}}
                  </a>
                {%- endif -%}
              </div>

            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.sophior-expertise-grid.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.sophior-expertise-grid.settings.heading.label",
      "default": "Meer dan alleen producten"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.sophior-expertise-grid.blocks.item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.sophior-expertise-grid.blocks.item.settings.image.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.sophior-expertise-grid.blocks.item.settings.label.label",
          "default": "Snijplanken"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.sophior-expertise-grid.blocks.item.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.sophior-expertise-grid.blocks.item.settings.link_text.label",
          "default": "Meer info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-expertise-grid.presets.default.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "label": "Snijplanken",
            "link": "/collections/snijplanken",
            "link_text": "Meer info"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Pannen",
            "link": "/collections/pannen",
            "link_text": "Meer info"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Messen",
            "link": "/collections/messen",
            "link_text": "Meer info"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Accessoires",
            "link": "/collections/accessoires",
            "link_text": "Meer info"
          }
        }
      ]
    }
  ]
}
{% endschema %}
