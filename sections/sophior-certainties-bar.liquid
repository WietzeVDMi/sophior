{{ 'sophior-certainties-bar.css' | asset_url | stylesheet_tag }}

<div class="sophior-certainties-bar color-{{ section.settings.color_scheme }} gradient">
  <div class="sophior-certainties-bar__inner page-width section-{{ section.id }}-padding">
    {%- if section.blocks.size > 0 -%}
      <ul class="sophior-certainties-bar__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="sophior-certainties-bar__item" {{ block.shopify_attributes }}>
              <span class="sophior-certainties-bar__icon" aria-hidden="true">
                {%- case block.settings.icon_type -%}
                  {%- when 'lock' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'truck' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'return' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
                  {%- when 'star' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- when 'leaf' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- endcase -%}
              </span>
              <span class="sophior-certainties-bar__text">{{ block.settings.text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.sophior-certainties-bar.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.sophior-certainties-bar.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.sophior-certainties-bar.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.label",
          "default": "lock",
          "options": [
            {
              "value": "lock",
              "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.options__1.label"
            },
            {
              "value": "truck",
              "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.options__2.label"
            },
            {
              "value": "return",
              "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.options__3.label"
            },
            {
              "value": "star",
              "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.options__4.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.options__5.label"
            },
            {
              "value": "shield",
              "label": "t:sections.sophior-certainties-bar.blocks.item.settings.icon_type.options__6.label"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.sophior-certainties-bar.blocks.item.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-certainties-bar.presets.name",
      "blocks": [
        { "type": "item", "settings": { "icon_type": "lock", "text": "Veilig betalen" } },
        { "type": "item", "settings": { "icon_type": "truck", "text": "Gratis verzending v.a. €59" } },
        { "type": "item", "settings": { "icon_type": "return", "text": "30 dagen retour" } },
        { "type": "item", "settings": { "icon_type": "star", "text": "Premium kwaliteit" } }
      ]
    }
  ],
  "templates": ["product"]
}
{% endschema %}
