{{ 'sophior-values-bar.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <section
    class="sophior-values-bar section-{{ section.id }}-padding"
    id="sophior-values-bar-{{ section.id }}"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="sophior-values-bar__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="sophior-values-bar__grid">
        {%- for block in section.blocks -%}
          <div class="sophior-values-bar__item" {{ block.shopify_attributes }}>
            {%- comment -%} Icoon {%- endcomment -%}
            <div class="sophior-values-bar__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 8C8 10 5.9 16.17 3.82 19.82a2 2 0 0 0 3.12 2.46C9.7 19.5 15 17 21 21a7 7 0 0 0-4-13z"/>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                {%- when 'award' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"/>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                  </svg>
                {%- else -%}
                  {%- comment -%} Default: check-circle {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
              {%- endcase -%}
            </div>

            {%- if block.settings.label != blank -%}
              <h3 class="sophior-values-bar__label">{{ block.settings.label | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="sophior-values-bar__desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.sophior-values-bar.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.sophior-values-bar.settings.heading.label",
      "default": "t:sections.sophior-values-bar.settings.heading.default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "t:sections.sophior-values-bar.blocks.value.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.label",
          "options": [
            { "value": "leaf",   "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.options.leaf" },
            { "value": "star",   "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.options.star" },
            { "value": "heart",  "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.options.heart" },
            { "value": "shield", "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.options.shield" },
            { "value": "award",  "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.options.award" },
            { "value": "check",  "label": "t:sections.sophior-values-bar.blocks.value.settings.icon.options.check" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.sophior-values-bar.blocks.value.settings.label.label"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:sections.sophior-values-bar.blocks.value.settings.description.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-values-bar.presets.default.name",
      "blocks": [
        { "type": "value", "settings": { "icon": "leaf",   "label": "t:sections.sophior-values-bar.presets.block_1.label" } },
        { "type": "value", "settings": { "icon": "award",  "label": "t:sections.sophior-values-bar.presets.block_2.label" } },
        { "type": "value", "settings": { "icon": "heart",  "label": "t:sections.sophior-values-bar.presets.block_3.label" } },
        { "type": "value", "settings": { "icon": "shield", "label": "t:sections.sophior-values-bar.presets.block_4.label" } }
      ]
    }
  ]
}
{% endschema %}
