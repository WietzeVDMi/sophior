{{ 'sophior-sustainability.css' | asset_url | stylesheet_tag }}

<section
  class="sophior-sustainability section-{{ section.id }}-padding"
  id="sophior-sustainability-{{ section.id }}"
>
  <div class="page-width">
    <div class="sophior-sustainability__layout{% if section.settings.image_position == 'right' %} sophior-sustainability__layout--img-right{% endif %}">

      {%- comment -%} Afbeelding {%- endcomment -%}
      <div class="sophior-sustainability__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag:
              class: 'sophior-sustainability__img',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | escape,
              widths: '400, 600, 800',
              sizes: '(max-width: 749px) 100vw, 50vw'
          }}
        {%- else -%}
          <div class="sophior-sustainability__img-placeholder"></div>
        {%- endif -%}
      </div>

      {%- comment -%} Tekst {%- endcomment -%}
      <div class="sophior-sustainability__text">
        {%- if section.settings.label != blank -%}
          <span class="sophior-sustainability__label">{{ section.settings.label | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sophior-sustainability__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="sophior-sustainability__content rte">{{ section.settings.content }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="sophior-sustainability__cta">
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.sophior-sustainability.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.sophior-sustainability.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.sophior-sustainability.settings.image_position.label",
      "options": [
        { "value": "left",  "label": "t:sections.sophior-sustainability.settings.image_position.options.left" },
        { "value": "right", "label": "t:sections.sophior-sustainability.settings.image_position.options.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:sections.sophior-sustainability.settings.label.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.sophior-sustainability.settings.heading.label",
      "default": "t:sections.sophior-sustainability.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.sophior-sustainability.settings.content.label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.sophior-sustainability.settings.cta_label.label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:sections.sophior-sustainability.settings.cta_url.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-sustainability.presets.default.name"
    }
  ]
}
{% endschema %}
