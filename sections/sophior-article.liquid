{{ 'sophior-article.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  sophior-article — Artikel detailpagina (gidsen).
  Gerenderd op /blogs/[handle]/[article-handle] via templates/article.json.
  Bevat: hero, auteur/datum, rich text content, sociale deelknoppen, gerelateerde artikelen.
{%- endcomment -%}

{%- assign current_url = shop.url | append: article.url -%}

<article
  class="sophior-article"
  id="sophior-article-{{ section.id }}"
  itemscope
  itemtype="https://schema.org/Article"
>
  {%- comment -%} Hero {%- endcomment -%}
  <header class="sophior-article__hero">
    {%- if article.image != blank -%}
      <div class="sophior-article__hero-media">
        {{
          article.image
          | image_url: width: 1400
          | image_tag:
            class: 'sophior-article__hero-img',
            loading: 'eager',
            fetchpriority: 'high',
            alt: article.image.alt | default: article.title | escape,
            widths: '750, 1100, 1400',
            sizes: '100vw'
        }}
      </div>
      <div class="sophior-article__hero-overlay"></div>
    {%- endif -%}

    <div class="sophior-article__hero-content page-width">
      {%- render 'sophior-breadcrumbs', breadcrumb_type: 'article' -%}

      <span class="sophior-article__category" itemprop="articleSection">{{ blog.title | escape }}</span>
      <h1 class="sophior-article__title" itemprop="name">{{ article.title | escape }}</h1>

      <div class="sophior-article__meta">
        {%- if section.settings.show_author and article.user.name != blank -%}
          <span class="sophior-article__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <span itemprop="name">{{ article.user.name | escape }}</span>
          </span>
          <span class="sophior-article__meta-sep" aria-hidden="true">·</span>
        {%- endif -%}
        <time
          class="sophior-article__date"
          datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
          itemprop="datePublished"
        >
          {{ article.published_at | date: '%d %B %Y' }}
        </time>
        {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
        {%- assign read_time = word_count | divided_by: 250 | at_least: 1 -%}
        <span class="sophior-article__meta-sep" aria-hidden="true">·</span>
        <span>{{ 'sections.sophior-article.read_time' | t: minutes: read_time }}</span>
      </div>
    </div>
  </header>

  {%- comment -%} Content {%- endcomment -%}
  <div class="sophior-article__body page-width">
    <div class="sophior-article__content rte" itemprop="articleBody">
      {{ article.content }}
    </div>

    {%- comment -%} Sociale deelknoppen {%- endcomment -%}
    {%- if section.settings.show_share -%}
      <div class="sophior-article__share" role="group" aria-label="{{ 'sections.sophior-article.share_label' | t }}">
        <span class="sophior-article__share-title">{{ 'sections.sophior-article.share_label' | t }}</span>

        {%- comment -%} Link kopiëren {%- endcomment -%}
        <button
          class="sophior-article__share-btn sophior-article__share-btn--copy"
          type="button"
          data-url="{{ current_url }}"
          aria-label="{{ 'sections.sophior-article.share_copy' | t }}"
          onclick="
            navigator.clipboard.writeText(this.dataset.url).then(function() {
              var btn = document.querySelector('.sophior-article__share-btn--copy');
              var orig = btn.textContent;
              btn.textContent = '✓';
              setTimeout(function() { btn.textContent = orig; }, 1500);
            });
          "
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          {{ 'sections.sophior-article.share_copy' | t }}
        </button>

        {%- comment -%} WhatsApp {%- endcomment -%}
        <a
          class="sophior-article__share-btn sophior-article__share-btn--whatsapp"
          href="https://wa.me/?text={{ article.title | url_encode }}%20{{ current_url | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'sections.sophior-article.share_whatsapp' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>

        {%- comment -%} Facebook {%- endcomment -%}
        <a
          class="sophior-article__share-btn sophior-article__share-btn--facebook"
          href="https://www.facebook.com/sharer/sharer.php?u={{ current_url | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'sections.sophior-article.share_facebook' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Facebook
        </a>
      </div>
    {%- endif -%}

    {%- comment -%} Terug naar blog link {%- endcomment -%}
    <a href="{{ blog.url }}" class="sophior-article__back-link">
      ← {{ 'sections.sophior-article.back_to_blog' | t: blog: blog.title }}
    </a>
  </div>

  {%- comment -%} Gerelateerde artikelen {%- endcomment -%}
  {%- if section.settings.show_related -%}
    {%- assign related_articles = blog.articles | where: 'id', article.id | map: 'id' -%}
    {%- assign has_related = false -%}
    {%- for art in blog.articles -%}
      {%- if art.id != article.id -%}
        {%- assign has_related = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_related -%}
      <div class="sophior-article__related">
        <div class="page-width">
          <h2 class="sophior-article__related-heading">{{ 'sections.sophior-article.related_heading' | t }}</h2>
          <ul class="sophior-article__related-grid" role="list">
            {%- assign count = 0 -%}
            {%- for art in blog.articles -%}
              {%- if art.id != article.id and count < 3 -%}
                {%- assign count = count | plus: 1 -%}
                <li>
                  <article class="sophior-article__related-card">
                    <a href="{{ art.url }}" class="sophior-article__related-media" tabindex="-1" aria-hidden="true">
                      {%- if art.image != blank -%}
                        {{
                          art.image
                          | image_url: width: 400
                          | image_tag:
                            class: 'sophior-article__related-img',
                            loading: 'lazy',
                            alt: art.image.alt | default: art.title | escape,
                            widths: '200, 300, 400',
                            sizes: '(max-width: 749px) 100vw, 33vw'
                        }}
                      {%- else -%}
                        <div class="sophior-article__related-img sophior-article__related-img--placeholder"></div>
                      {%- endif -%}
                    </a>
                    <div class="sophior-article__related-body">
                      <h3 class="sophior-article__related-title">
                        <a href="{{ art.url }}" class="sophior-article__related-title-link">{{ art.title | escape }}</a>
                      </h3>
                      <time class="sophior-article__related-date" datetime="{{ art.published_at | date: '%Y-%m-%d' }}">
                        {{ art.published_at | date: '%d %B %Y' }}
                      </time>
                    </div>
                  </article>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</article>

{% schema %}
{
  "name": "t:sections.sophior-article.name",
  "tag": "article",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.sophior-article.settings.show_author.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:sections.sophior-article.settings.show_share.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "t:sections.sophior-article.settings.show_related.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-article.presets.default.name"
    }
  ]
}
{% endschema %}
