{{ 'sophior-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign main_menu = section.settings.main_menu | default: 'main-menu'
  assign menu = linklists[main_menu]
-%}

<header class="sophior-header" role="banner">
  <div class="sophior-header__inner">

    {%- comment -%} Hamburger — alleen mobile {%- endcomment -%}
    <button
      class="sophior-header__hamburger"
      aria-controls="sophior-mobile-nav"
      aria-expanded="false"
      aria-label="{{ 'sections.sophior-header.mobile_menu_open' | t }}"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="sophior-header__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 440 | image_tag:
          width: 220,
          height: 48,
          alt: shop.name,
          loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'sophior-logo-light.svg' | asset_url }}"
          alt="{{ shop.name }}"
          width="165"
          height="36"
          loading="eager"
        >
      {%- endif -%}
      {%- render 'sophior-ring', variant: 'logo', class: 'sophior-header__ring' -%}
    </a>

    {%- comment -%} Desktop navigatie {%- endcomment -%}
    <nav aria-label="{{ 'sections.sophior-header.nav_aria_label' | t }}">
      <ul class="sophior-header__nav" role="list">
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 and link.title == section.settings.mega_menu_trigger -%}
            {%- comment -%} Mega menu voor 'Producten' {%- endcomment -%}
            <li class="sophior-header__nav-item">
              <a
                href="{{ link.url }}"
                class="sophior-header__nav-link"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {{ link.title }}
                <svg width="12" height="8" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M1 1.5L6 6.5L11 1.5"/>
                </svg>
              </a>

              <div class="sophior-mega-menu" role="region" aria-label="{{ link.title }}">

                {%- comment -%} Categorie-kolommen met sfeerfoto {%- endcomment -%}
                <div class="sophior-mega-menu__categories">
                  {%- for child_link in link.links -%}
                    {%- case forloop.index -%}
                      {%- when 1 -%}{%- assign col_img = section.settings.mega_col_1_image -%}
                      {%- when 2 -%}{%- assign col_img = section.settings.mega_col_2_image -%}
                      {%- when 3 -%}{%- assign col_img = section.settings.mega_col_3_image -%}
                      {%- when 4 -%}{%- assign col_img = section.settings.mega_col_4_image -%}
                      {%- else -%}{%- assign col_img = blank -%}
                    {%- endcase -%}
                    <div class="sophior-mega-menu__col">
                      {%- if col_img != blank -%}
                        <a href="{{ child_link.url }}" class="sophior-mega-menu__col-img-link" tabindex="-1" aria-hidden="true">
                          {{
                            col_img
                            | image_url: width: 240
                            | image_tag:
                              class: 'sophior-mega-menu__col-img',
                              loading: 'lazy',
                              alt: child_link.title | escape,
                              widths: '160, 240',
                              sizes: '200px'
                          }}
                        </a>
                      {%- endif -%}
                      <a href="{{ child_link.url }}" class="sophior-mega-menu__col-title-link">
                        <p class="sophior-mega-menu__col-title">{{ child_link.title }}</p>
                      </a>
                      {%- if child_link.links.size > 0 -%}
                        <ul class="sophior-mega-menu__list" role="list">
                          {%- for grandchild_link in child_link.links -%}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="sophior-mega-menu__link">
                                {{ grandchild_link.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <a href="{{ child_link.url }}" class="sophior-mega-menu__link">
                          {{ 'sections.sophior-header.view_all' | t }}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>

                {%- comment -%} Rechter actie-blokken {%- endcomment -%}
                <div class="sophior-mega-menu__actions">
                  <a href="/collections/all" class="sophior-mega-menu__action-block sophior-mega-menu__action-block--all">
                    <span class="sophior-mega-menu__action-label">Alle Producten</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                  {%- if section.settings.mega_sale_label != blank -%}
                    <a href="{{ section.settings.mega_sale_url | default: '/collections/sale' }}" class="sophior-mega-menu__action-block sophior-mega-menu__action-block--sale">
                      <span class="sophior-mega-menu__action-badge">Actie</span>
                      <span class="sophior-mega-menu__action-label">{{ section.settings.mega_sale_label | escape }}</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  {%- endif -%}
                </div>

              </div>
            </li>
          {%- else -%}
            <li class="sophior-header__nav-item">
              <a
                href="{{ link.url }}"
                class="sophior-header__nav-link"
                {% if link.active %}aria-current="page"{% endif %}
              >{{ link.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Utility icons {%- endcomment -%}
    <div class="sophior-header__utils">

      {%- comment -%} Zoeken {%- endcomment -%}
      <a href="{{ routes.search_url }}" class="sophior-header__icon-btn" aria-label="{{ 'general.search.search' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M16.5 16.5L21 21"/>
        </svg>
      </a>

      {%- comment -%} Account {%- endcomment -%}
      <a href="{{ routes.account_url }}" class="sophior-header__icon-btn" aria-label="{{ 'customer.account.title' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      {%- comment -%} Cart {%- endcomment -%}
      <button
        type="button"
        class="sophior-header__icon-btn"
        id="sophior-cart-btn"
        aria-label="{{ 'sections.sophior-cart-drawer.open' | t }}"
        onclick="document.dispatchEvent(new CustomEvent('sophior:open-cart'))"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="sophior-header__cart-count" aria-label="{{ cart.item_count }} {{ 'sections.cart.title' | t | downcase }}">
            {{- cart.item_count -}}
          </span>
        {%- endif -%}
      </button>

    </div>
  </div>
</header>

{%- comment -%} Mobile nav drawer {%- endcomment -%}
<div
  id="sophior-mobile-nav"
  class="sophior-mobile-nav"
  aria-hidden="true"
  aria-label="{{ 'sections.sophior-header.mobile_menu_label' | t }}"
>
  <div class="sophior-mobile-nav__overlay" tabindex="-1" data-action="close-mobile-nav"></div>
  <nav class="sophior-mobile-nav__panel" role="navigation">
    <div class="sophior-mobile-nav__header">
      <img
        src="{{ 'sophior-logo-light.svg' | asset_url }}"
        alt="{{ shop.name }}"
        width="120"
        height="28"
        loading="lazy"
      >
      <button
        class="sophior-mobile-nav__close"
        data-action="close-mobile-nav"
        aria-label="{{ 'sections.sophior-header.mobile_menu_close' | t }}"
      >×</button>
    </div>

    <ul class="sophior-mobile-nav__list" role="list">
      {%- for link in menu.links -%}
        <li>
          <a href="{{ link.url }}" class="sophior-mobile-nav__link"
            {% if link.active %}aria-current="page"{% endif %}
          >{{ link.title }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

<script>
  (function () {
    var hamburger = document.querySelector('.sophior-header__hamburger');
    var mobileNav = document.getElementById('sophior-mobile-nav');
    var closeButtons = document.querySelectorAll('[data-action="close-mobile-nav"]');

    function openNav() {
      hamburger.setAttribute('aria-expanded', 'true');
      mobileNav.classList.add('sophior-mobile-nav--open');
      mobileNav.setAttribute('aria-hidden', 'false');
      document.body.classList.add('sophior-nav-open');
    }

    function closeNav() {
      hamburger.setAttribute('aria-expanded', 'false');
      mobileNav.classList.remove('sophior-mobile-nav--open');
      mobileNav.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('sophior-nav-open');
    }

    if (hamburger) {
      hamburger.addEventListener('click', function () {
        if (hamburger.getAttribute('aria-expanded') === 'true') {
          closeNav();
        } else {
          openNav();
        }
      });
    }

    closeButtons.forEach(function (btn) {
      btn.addEventListener('click', closeNav);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeNav();
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.sophior-header.name",
  "class": "sophior-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.sophior-header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "t:sections.sophior-header.settings.logo_width.label",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "t:sections.sophior-header.settings.main_menu.label",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "mega_menu_trigger",
      "label": "t:sections.sophior-header.settings.mega_menu_trigger.label",
      "default": "Producten",
      "info": "t:sections.sophior-header.settings.mega_menu_trigger.info"
    },
    {
      "type": "header",
      "content": "Mega menu — Categorie afbeeldingen"
    },
    {
      "type": "image_picker",
      "id": "mega_col_1_image",
      "label": "Categorie 1 afbeelding (bijv. Snijplanken)"
    },
    {
      "type": "image_picker",
      "id": "mega_col_2_image",
      "label": "Categorie 2 afbeelding (bijv. Pannen)"
    },
    {
      "type": "image_picker",
      "id": "mega_col_3_image",
      "label": "Categorie 3 afbeelding (bijv. Messen)"
    },
    {
      "type": "image_picker",
      "id": "mega_col_4_image",
      "label": "Categorie 4 afbeelding (bijv. Accessoires)"
    },
    {
      "type": "header",
      "content": "Mega menu — Actie-blok"
    },
    {
      "type": "text",
      "id": "mega_sale_label",
      "label": "Actie-label tekst",
      "info": "Leeg laten om het actie-blok te verbergen.",
      "default": "Nu tot 30% korting"
    },
    {
      "type": "url",
      "id": "mega_sale_url",
      "label": "Actie-blok URL"
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-header.name"
    }
  ]
}
{% endschema %}
