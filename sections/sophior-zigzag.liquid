{{ 'sophior-zigzag.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <section
    class="sophior-zigzag section-{{ section.id }}-padding"
    id="sophior-zigzag-{{ section.id }}"
  >
    <div class="page-width">
      {%- for block in section.blocks -%}
        {%- assign reverse = false -%}
        {%- if forloop.index0 | modulo: 2 == 1 -%}{%- assign reverse = true -%}{%- endif -%}

        <div
          class="sophior-zigzag__row{% if reverse %} sophior-zigzag__row--reverse{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Afbeelding {%- endcomment -%}
          <div class="sophior-zigzag__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'sophior-zigzag__img',
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: block.settings.heading | escape,
                  widths: '400, 600, 800',
                  sizes: '(max-width: 749px) 100vw, 50vw'
              }}
            {%- else -%}
              <div class="sophior-zigzag__img-placeholder"></div>
            {%- endif -%}
          </div>

          {%- comment -%} Tekst {%- endcomment -%}
          <div class="sophior-zigzag__text">
            {%- if block.settings.label != blank -%}
              <span class="sophior-zigzag__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="sophior-zigzag__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.content != blank -%}
              <div class="sophior-zigzag__content rte">{{ block.settings.content }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.sophior-zigzag.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.sophior-zigzag.blocks.row.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.sophior-zigzag.blocks.row.settings.image.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.sophior-zigzag.blocks.row.settings.label.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.sophior-zigzag.blocks.row.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.sophior-zigzag.blocks.row.settings.content.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sophior-zigzag.presets.default.name",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "t:sections.sophior-zigzag.presets.block_1.heading",
            "content": "t:sections.sophior-zigzag.presets.block_1.content"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "t:sections.sophior-zigzag.presets.block_2.heading",
            "content": "t:sections.sophior-zigzag.presets.block_2.content"
          }
        }
      ]
    }
  ]
}
{% endschema %}
