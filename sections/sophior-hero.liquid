{{ 'sophior-hero.css' | asset_url | stylesheet_tag }}

<section class="sophior-hero" aria-label="{{ section.settings.heading | escape }}">

  {%- comment -%} Tekst kant (links) {%- endcomment -%}
  <div class="sophior-hero__content">
    <h1 class="sophior-hero__heading">{{ section.settings.heading }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="sophior-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link }}" class="sophior-hero__cta">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} Afbeelding kant (rechts) {%- endcomment -%}
  <div class="sophior-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag:
          class: 'sophior-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.heading | escape,
          widths: '600, 900, 1200',
          sizes: '(max-width: 749px) 100vw, 50vw'
      }}
    {%- else -%}
      <div class="sophior-hero__placeholder" aria-hidden="true">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 15l-5-5L11 15l-4-4L3 15V5a2 2 0 012-2h14a2 2 0 012 2v10zM3 19v-2l4-4 4 4 5-5 5 5v2a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
        </svg>
      </div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "sophior-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.sophior-hero.settings.heading.label",
      "default": "Premium keukenmessen & snijplanken"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.sophior-hero.settings.subheading.label",
      "default": "Handgemaakt voor thuiskoks die kwaliteit serieus nemen. Ontdek de collectie van SOPHIOR."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.sophior-hero.settings.cta_label.label",
      "default": "Bekijk de collectie"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.sophior-hero.settings.cta_link.label",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.sophior-hero.settings.image.label"
    }
  ],
  "presets": [
    {
      "name": "SOPHIOR Hero"
    }
  ]
}
{% endschema %}
