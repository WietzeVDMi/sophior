{{ 'sophior-usp-accordion.css' | asset_url | stylesheet_tag }}

<div class="sophior-usp-accordion">
  <div class="sophior-usp-accordion__grid">

    {%- comment -%} Links: titel + accordeon items {%- endcomment -%}
    <div class="sophior-usp-accordion__content">
      {%- render 'sophior-ring', variant: 'divider' -%}
      <h2 class="sophior-usp-accordion__title">{{ section.settings.title }}</h2>

      <div class="sophior-usp-accordion__items">
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            <details
              class="sophior-usp-accordion__item"
              {% if forloop.first %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="sophior-usp-accordion__summary">
                {{ block.settings.question }}
                <span class="sophior-usp-accordion__chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
                </span>
              </summary>
              {%- if block.settings.answer != blank -%}
                <p class="sophior-usp-accordion__answer">{{ block.settings.answer }}</p>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Rechts: afbeelding met jaarringen achtergrond {%- endcomment -%}
    <div class="sophior-usp-accordion__media">
      <svg class="sophior-ring-deco sophior-usp-accordion__ring-bg"
           viewBox="0 0 400 400" fill="none" aria-hidden="true" focusable="false">
        <circle cx="200" cy="200" r="50"  stroke="currentColor" stroke-width="1.5"/>
        <circle cx="200" cy="200" r="105" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="200" cy="200" r="160" stroke="currentColor" stroke-width="1"/>
        <circle cx="200" cy="200" r="193" stroke="currentColor" stroke-width="0.8"/>
      </svg>
      {%- if section.settings.image != blank -%}
        {%- assign usp_alt = section.settings.title | escape -%}
        {{
          section.settings.image
          | image_url: width: 800
          | image_tag:
            class: 'sophior-usp-accordion__image',
            loading: 'lazy',
            alt: usp_alt,
            widths: '400, 600, 800',
            sizes: '(max-width: 749px) 100vw, 50vw'
        }}
      {%- else -%}
        <div class="sophior-usp-accordion__placeholder" aria-hidden="true"></div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "USP Accordeon",
  "tag": "div",
  "class": "sophior-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.sophior-usp-accordion.settings.title.label",
      "default": "Waarom SOPHIOR"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.sophior-usp-accordion.settings.image.label"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordeon item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.sophior-usp-accordion.blocks.accordion_item.settings.question.label",
          "default": "Specialist in houten snijplanken"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "t:sections.sophior-usp-accordion.blocks.accordion_item.settings.answer.label",
          "default": "SOPHIOR ontwikkelt hoogwaardige snijplanken van massief hout. Met een zorgvuldig productieproces zorgen we voor stabiliteit, hygiëne en jarenlang dagelijks gebruik in elke keuken."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOPHIOR USP Accordeon",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": {
            "question": "Specialist in houten snijplanken",
            "answer": "SOPHIOR ontwikkelt hoogwaardige snijplanken van massief hout. Met een zorgvuldig productieproces zorgen we voor stabiliteit, hygiëne en jarenlang dagelijks gebruik in elke keuken."
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "question": "Gezond koken zonder schadelijke stoffen",
            "answer": "Onze pannen zijn PFAS-vrij en onze snijplanken bevatten geen microplastics. Je kookt met pure materialen zoals massief hout en roestvrij staal. Veilig voor jou en je gezin."
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "question": "Gemaakt voor dagelijks gebruik",
            "answer": "Duurzaamheid betekent bij ons: producten die lang meegaan. Door te kiezen voor massief hout en sterk roestvrij staal blijven onze producten betrouwbaar, scherp en stabiel. Elke dag opnieuw."
          }
        }
      ]
    }
  ]
}
{% endschema %}
